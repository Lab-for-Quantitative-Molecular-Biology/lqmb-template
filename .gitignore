# ============================================================
# LQMB research repository
# Default rule: raw, sensitive, confidential and large research
# data do not belong in Git. See data/README.md.
# ============================================================

# ----------------------------------------------------------------
# Research data and generated outputs
# ----------------------------------------------------------------

# Ignore everything under data/ except documentation/placeholders.
data/*
!data/README.md
!data/.gitkeep

# Ignore generated outputs by default.
outputs/*
!outputs/README.md
!outputs/.gitkeep

# Common scientific data formats
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.bam
*.bai
*.sam
*.cram
*.crai
*.vcf
*.vcf.gz
*.bcf
*.h5
*.hdf5
*.h5ad
*.loom
*.zarr
*.tif
*.tiff
*.nd2
*.czi
*.lif
*.svs
*.mzML
*.mzXML
*.raw
*.d

# Common generated analysis / serialisation files
*.pkl
*.pickle
*.rds
*.RData
*.rda
*.feather
*.parquet

# ----------------------------------------------------------------
# Secrets / local configuration
# ----------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json

# ----------------------------------------------------------------
# Logs / temporary files
# ----------------------------------------------------------------
*.log
*.tmp
*.temp
*.swp
*.swo
.DS_Store
Thumbs.db

# ----------------------------------------------------------------
# Python
# ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.pyre/
.venv/
venv/
env/

# ----------------------------------------------------------------
# R
# ----------------------------------------------------------------
.Rhistory
.RData
.Ruserdata
.Rproj.user/

# ----------------------------------------------------------------
# Jupyter
# ----------------------------------------------------------------
.ipynb_checkpoints/

# ----------------------------------------------------------------
# Node / JavaScript (if used by a project)
# ----------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ----------------------------------------------------------------
# IDEs
# ----------------------------------------------------------------
.vscode/
.idea/

# ----------------------------------------------------------------
# OS / tooling
# ----------------------------------------------------------------
.DS_Store
